# --- OpenAI (used for field extraction only, never for routing/scoring) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role key (server-side only, never expose to frontend)

# --- Twilio WhatsApp Sandbox ---
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_WEBHOOK_URL=https://your-public-host/webhook/whatsapp

# --- Notifications (pick ONE) ---
# Option A: n8n webhook
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-handoff
N8N_WEBHOOK_SECRET=replace-with-a-random-secret

# Option B: Resend email
RESEND_API_KEY=re_xxxxxxxx
AGENT_EMAIL=agent@example.com
FROM_EMAIL=leads@yourdomain.com

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your Next.js dev URL)
CORS_ORIGIN=http://localhost:3000
BOOKING_URL=https://cal.com/your-agency/intro-call
MAX_CONFIRMATION_HOLDS=2
